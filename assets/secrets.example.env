# TraderSkill secrets — EXAMPLE ONLY (dummy values, safe to publish).
# Copy to trader-data/secrets.env on YOUR computer and fill in real values there.
# trader-data/ is git-ignored, so real keys never reach GitHub.
# Load with: python scripts/secrets_local.py check   (prints which keys are set, masked)

# --- Webull OpenAPI (developer.webull.com) — or use the Webull connector in Claude instead
WEBULL_APP_KEY=your-webull-app-key
WEBULL_APP_SECRET=your-webull-app-secret
WEBULL_ACCOUNT_ID=your-webull-account-id

# --- Zerodha: the official `kite` CLI keeps its own session after `kite auth login`.
# Only needed if you use Kite Connect directly from Python:
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret

# --- Optional brokers
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
UPSTOX_ACCESS_TOKEN=your-upstox-daily-token
